}\n      requestAnimationFrame(draw); };\n    if (!reduce) draw(); else { t = 1; }\n    this._stop = () => { run = false; ro.disconnect(); };\n  }\n  componentWillUnmount() { this._off && this._off(); this._stop && this._stop(); }\n  heroTitle() {\n    if (this._hero) return this._hero;\n    const gold = { backgroundImage: 'linear-gradient(90deg,#a8841f,#f6ebb8,#c9a227,#e8d078,#a8841f)', backgroundSize: '300% auto', WebkitBackgroundClip: 'text', backgroundClip: 'text', WebkitTextFillColor: 'transparent', padding: '.12em .08em', margin: '-.12em -.08em', animation: 'charIn .9s cubic-bezier(.16,1,.3,1) both, shine 7s linear infinite 1.2s' };\n    const teal = { ...gold, backgroundImage: 'linear-gradient(90deg,#1b7f9c,#8fe0f2,#7a5a99,#c9a9e0,#1b7f9c)' };\n    const lines = [[['Tell us about the ', { color: '#0b1220' }], ['business,', gold, 400]], [['and we will map the ', { color: '#7a8294' }], ['build.', teal, 400]]];\n    let i = 0; const kids = [];\n    lines.forEach((line, li) => { line.forEach(([txt, st, fw]) => { for (const word of txt.split(/(\\s+)/)) { if (!word) continue; if (/^\\s+$/.test(word)) { kids.push(React.createElement('span', { key: 'sp' + (i++), style: { whiteSpace: 'pre' } }, ' ')); continue; } const k = i++;\n      kids.push(React.createElement('span', { key: k, style: { display: 'inline-block', whiteSpace: 'nowrap', fontWeight: fw || 300, fontStyle: fw ? 'italic' : 'normal', transformOrigin: '50% 100%', animation: 'charIn .9s cubic-bezier(.16,1,.3,1) both', animationDelay: `${.25 + k * .12}s`, ...st, ...(st.animation ? { animation: st.animation, animationDelay: `${.25 + k * .12}s, 1.2s` } : {}) } }, word)); } });\n      if (li < lines.length - 1) kids.push(React.createElement('br', { key: 'br' + li })); });\n    return (this._hero = React.createElement(React.Fragment, null, kids));\n  }\n  renderVals() {\n    const m = (this.props.mobile === true || this.state.narrow);\n    return {\n      // header\n      ...(() => { const mm = m, a = 'contact', 