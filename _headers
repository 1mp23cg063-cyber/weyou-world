/*
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval' https://unpkg.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com data:; img-src 'self' https: data: blob:; connect-src 'self' https://formsubmit.co https://unpkg.com; frame-ancestors 'none';
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload

/support.js
  Content-Type: application/javascript; charset=utf-8
  Cache-Control: public, max-age=3600

/assets/vendor/*
  Cache-Control: public, max-age=31536000, immutable
  X-Robots-Tag: noindex, nofollow

/assets/dc/*
  Cache-Control: public, max-age=300
  X-Robots-Tag: noindex, nofollow

/src/*
  X-Robots-Tag: noindex, nofollow

/dev-log/*
  X-Robots-Tag: noindex, nofollow

/build/*
  X-Robots-Tag: noindex, nofollow

/CLAUDE.md
  X-Robots-Tag: noindex, nofollow

/package.json
  X-Robots-Tag: noindex, nofollow

/seo/*
  X-Robots-Tag: noindex, nofollow
